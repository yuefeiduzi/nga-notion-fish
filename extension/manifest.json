{
    "manifest_version": 3,
    "name": "NGA 阅读器",
    "version": "0.5.0",
    "description": "把 NGA 论坛（ngabbs.com / bbs.nga.cn）读成一份资讯日报：侧边栏导航 + 数字编号的楼层正文，支持暗色模式、无图模式与图片全屏预览。",
    "minimum_chrome_version": "111",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://ngabbs.com/*",
        "https://*.ngabbs.com/*",
        "https://bbs.nga.cn/*",
        "https://*.nga.cn/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://ngabbs.com/*",
                "https://*.ngabbs.com/*",
                "https://bbs.nga.cn/*",
                "https://*.nga.cn/*"
            ],
            "js": [
                "src/boot.js"
            ],
            "css": [
                "src/styles/boot.css",
                "src/styles/app.css"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/*",
                "src/**/*"
            ],
            "matches": [
                "https://ngabbs.com/*",
                "https://*.ngabbs.com/*",
                "https://bbs.nga.cn/*",
                "https://*.nga.cn/*"
            ]
        }
    ],
    "action": {
        "default_title": "NGA 阅读器 · 设置",
        "default_popup": "popup/popup.html"
    }
}
